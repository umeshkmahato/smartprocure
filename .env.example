# =============================================================================
# ── Notification Service  ──────────────────────────────────────
NOTIFICATION_SERVICE_PORT=8081
NOTIFICATION_KAFKA_GROUP=sp-notification-group
NOTIFICATION_FROM_ADDRESS=no-reply@smartprocure.internal
NOTIFICATION_IDEMPOTENCY_TTL_DAYS=7
# =============================================================================
# SmartProcure – Environment Variable Reference
# =============================================================================
# USAGE:
#   cp .env.example .env
#   Edit .env with real values
#   NEVER commit .env to source control (it is in .gitignore)
# =============================================================================

# ── Spring ────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/smartprocure
DB_USERNAME=smartprocure
DB_PASSWORD=change_me_in_production
DB_PORT=5432
DB_POOL_MAX=20
DB_POOL_MIN=5

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=sp-main-group
KAFKA_PORT=9092

# ── JWT (generate with: openssl rand -base64 64) ─────────────────────────
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_BASE64_STRING_AT_LEAST_256_BITS
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Mail (MailHog for local dev) ──────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_TLS=false

# ── Ollama AI ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=llama3.2:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
AI_TIMEOUT=30

# ── File Upload ───────────────────────────────────────────────────────────
INVOICE_UPLOAD_DIR=./uploads/invoices
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# ── Observability ─────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLE_RATE=1.0
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
